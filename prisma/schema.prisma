generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  price     Int // rupiah, tanpa desimal
  stock     Int      @default(0)
  category  String   @default("Umum")
  icon      String   @default("") // emoji per produk, fallback ikon kategori
  createdAt DateTime @default(now())

  items TransactionItem[]
  moves StockMove[]

  @@map("products")
}

model Transaction {
  id         String   @id @default(uuid())
  subtotal   Int      @default(0)
  discount   Int      @default(0)
  tax        Int      @default(0)
  total      Int
  cash       Int
  change     Int
  payment    String   @default("CASH") // CASH | QRIS
  createdAt  DateTime @default(now())

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  items TransactionItem[]

  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  qty           Int
  price         Int // snapshot harga saat jual

  @@map("transaction_items")
}

// Shift kasir: modal awal vs kas akhir (rekonsiliasi)
model Shift {
  id        String    @id @default(uuid())
  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  modalAwal Int       @default(0)
  kasFisik  Int?
  status    String    @default("BUKA") // BUKA | TUTUP

  transactions Transaction[]

  @@map("shifts")
}

// Pengaturan global (key-value): pajak otomatis, dll.
model Setting {
  key   String @id
  value String

  @@map("settings")
}

// Kartu stok: semua perubahan stok tercatat
model StockMove {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int // + masuk, - keluar
  reason    String // PENJUALAN | KULAKAN | KOREKSI | STOK_AWAL
  refId     String?
  createdAt DateTime @default(now())

  @@map("stock_moves")
}
