# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit `.env` — sudah masuk .gitignore.

# ── Postgres (Supabase) ─────────────────────────────────────────
# Koneksi POOLED (pgbouncer, port 6543) untuk runtime/serverless (Vercel).
# Wajib: `?pgbouncer=true` + `connection_limit=1` saat dipakai Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DB?pgbouncer=true&connection_limit=1"

# Koneksi DIRECT (port 5432) untuk migrasi & introspection Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# URL khusus TEST (WAJIB bila menjalankan `npm test`): DB Postgres TERPISAH agar
# test tidak menyentuh data dev/produksi. Test MENOLAK jalan bila kosong — tidak
# ada fallback ke DATABASE_URL/DIRECT_URL. Host-nya HARUS beda dari
# DATABASE_URL/DIRECT_URL (test menolak bila host sama, mis. project Supabase
# yang sama). Buat project Supabase kedua khusus test.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@TEST_HOST:5432/DB_TEST"

# ── Sesi ────────────────────────────────────────────────────────
# Kunci HMAC untuk menandatangani cookie sesi. WAJIB diisi (minimal 16 karakter).
# Buat nilai acak, mis.:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Rotasi nilai ini akan membatalkan semua sesi aktif.
SESSION_SECRET=ganti-dengan-string-acak-berikut

# ── Seed (opsional) ─────────────────────────────────────────────
# Kredensial akun demo yang dibuat `npm run db:seed`. Kosongkan untuk memakai
# default (owner "password123", PIN kasir "123456") — default ini hanya aman
# untuk dev lokal/demo.
# SEED_OWNER_PASSWORD=password123
# SEED_KASIR_PIN=123456
#
# Pengaman non-lokal: seed MENOLAK berjalan ke DB non-lokal (mis. produksi)
# kecuali ALLOW_SEED_NON_LOCAL=1. Lapis kedua: bila ALLOW_SEED_NON_LOCAL=1 tapi
# kredensial masih DEFAULT, seed tetap ditolak kecuali Anda ubah kredensial di
# atas ATAU menegaskan ALLOW_WEAK_SEED_CREDS=1.
# ALLOW_SEED_NON_LOCAL=1
# ALLOW_WEAK_SEED_CREDS=1

# ── AI ("KRING! Insight") — lampiran PRD-lampiran-ai.md §2 ───────
# Semua env provider dibaca HANYA di satu tempat (src/server/ai/config.ts).
# Tidak ada URL/key yang di-hardcode di kode.
#
# Fail-safe: bila AI_ENABLED bukan "true" ATAU AI_API_KEY kosong → fitur AI OFF
# dan TIDAK ada LLM call. Kasir TIDAK pernah terpengaruh (AI bukan di jalur
# kasir). AI hanya untuk warung ber-status ACTIVE (plan gratis/TRIAL = tanpa LLM).

# Flag global per-deploy. Set "true" untuk mengaktifkan fitur AI.
AI_ENABLED="false"

# Provider: "9router" (Tier 1 — gateway pribadi pilot, OpenAI-compatible, Rp0)
#         | "managed" (Tier 2 — provider berbayar per token, saat go-public).
# Tier 1 HANYA untuk pilot: jangan menyajikan pelanggan berbayar dengan akun
# pribadi (risiko rate-limit/ban). Ganti tier = keputusan eksplisit, bukan otomatis.
AI_PROVIDER="9router"

# Base URL OpenAI-compatible TANPA suffix /chat/completions.
# Tier 1 default produksi (Cloudflare tunnel): https://llm.kianlabs.my.id/v1
# Dev lokal (Tailscale/LAN), contoh:        http://100.108.127.6:20128/v1
AI_BASE_URL="https://llm.kianlabs.my.id/v1"

# API key provider (WAJIB bila AI_ENABLED=true — kosong = fitur OFF).
# Untuk 9router: key gateway. JANGAN commit key asli.
AI_API_KEY=""

# Nama model dari katalog allowlist (kelas Gemini Flash / DeepSeek / Haiku).
# Nama model JANGAN dimasukkan ke prompt user.
AI_MODEL="gemini-2.0-flash"
