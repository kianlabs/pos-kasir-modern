# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit `.env` — sudah masuk .gitignore.

# SQLite lokal untuk development.
DATABASE_URL="file:./dev.db"

# Kunci HMAC untuk menandatangani cookie sesi. WAJIB diisi (minimal 16 karakter).
# Buat nilai acak, mis.:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Rotasi nilai ini akan membatalkan semua sesi aktif.
SESSION_SECRET=ganti-dengan-string-acak-berikut
